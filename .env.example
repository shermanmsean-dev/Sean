# PostgreSQL connection string (Replit sets this automatically for its database)
DATABASE_URL=postgresql://user:password@localhost:5432/paddock17

# Admin portal password. Required — the admin portal is disabled if unset.
ADMIN_PASSWORD=choose_a_long_random_password

# Invite code members enter to join. Required — sign-ups are disabled if unset.
MEMBER_CODE=choose_a_new_code

# Port the server listens on (defaults to 5000)
PORT=5000
